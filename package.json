{
  "name": "almai-ads-products",
  "version": "1.0.0",
  "description": "Almai Ads Products — Production Cloudflare Pages, D1 Database & Pages Functions",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev . --d1 DB=almai-db --compatibility-date=2024-04-01",
    "d1:create": "wrangler d1 create almai-db",
    "d1:migrate:local": "wrangler d1 execute almai-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:migrate:remote": "wrangler d1 execute almai-db --remote --file=./migrations/0001_initial_schema.sql",
    "deploy": "wrangler pages deploy ."
  },
  "keywords": [
    "cloudflare-pages",
    "cloudflare-d1",
    "pages-functions",
    "kenya",
    "m-pesa",
    "ads-network"
  ],
  "author": "Almai Media",
  "license": "ISC"
}
